{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/narrowsburg.html", "destination": "/narrowsburg", "permanent": true },
    { "source": "/collection.html", "destination": "/collection", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/narrowsburg/index.html", "destination": "/narrowsburg", "permanent": true },
    { "source": "/collection/index.html", "destination": "/collection", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/narrowsburg", "destination": "/narrowsburg.html" },
    { "source": "/collection", "destination": "/collection.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
