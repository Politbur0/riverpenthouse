    { "source": "/blog/perfect-fall-weekend-narrowsburg.html", "destination": "/blog/perfect-fall-weekend-narrowsburg", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/narrowsburg", "destination": "/narrowsburg.html" },
    { "source": "/collection", "destination": "/collection.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/where-to-see-bald-eagles-narrowsburg", "destination": "/blog/where-to-see-bald-eagles-narrowsburg.html" },
